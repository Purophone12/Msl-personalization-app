<Window x:Class="DomainPersonalizationSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Domain Personalization Setup" Height="450" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{Binding AccentColor, FallbackValue=#0078D4}" Padding="15">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding LogoPath}" Width="40" Height="40" Margin="0,0,15,0"
                       Visibility="{Binding HasLogo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding OrganizationName}" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <!-- Footer / Navigation -->
        <Border Grid.Row="2" Background="#F3F3F3" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Command="{Binding BackCommand}" Width="80" Margin="0,0,10,0"
                        Visibility="{Binding ShowBackButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}" Width="80" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
