<Page x:Class="DomainPersonalizationSetup.Views.ExtraSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="300" d:DesignWidth="600"
      Title="ExtraSettingsPage">
    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Quick Access &amp; Defaults" FontSize="22" Margin="0,0,0,10"/>
            <TextBlock Text="Fine-tune your Windows experience with these quick settings." Margin="0,0,0,30" Foreground="#555"/>

            <StackPanel x:Name="TaskbarSettings" Margin="0,0,0,30">
                <TextBlock Text="Taskbar Alignment (Windows 11)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LeftAlignmentRadio" Content="Left" IsChecked="True" Margin="0,0,20,0" Padding="5,0,0,0"/>
                    <RadioButton x:Name="CenterAlignmentRadio" Content="Center" Padding="5,0,0,0"/>
                </StackPanel>
                <Button Content="Apply Alignment" Click="ApplyAlignment_Click" Margin="0,15,0,0" Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel x:Name="DefaultAppsSettings">
                <TextBlock Text="Browser &amp; Default Apps" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="To set your default browser, please use the Windows Settings app." FontSize="14" Foreground="#555" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Button Content="Open Default Apps Settings" Click="OpenDefaultApps_Click" Width="200" HorizontalAlignment="Left" Padding="10,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
