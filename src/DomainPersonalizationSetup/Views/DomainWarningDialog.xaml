<Window x:Class="DomainPersonalizationSetup.Views.DomainWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Domain Environment Warning" Height="220" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F3F3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="This setup tool is intended for domain-joined devices, so it may not work on this device but you can try anyway. We are not responsible for irreparable harm to your device."
                   TextWrapping="Wrap" FontSize="14" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Continue Anyway" Width="120" Margin="0,0,10,0" Click="Continue_Click" Padding="10,5"/>
            <Button Content="Exit" Width="80" Click="Exit_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
