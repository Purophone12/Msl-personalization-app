<Page x:Class="DomainPersonalizationSetup.Views.WallpaperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="300" d:DesignWidth="600"
      Title="WallpaperPage">
    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Personalize your Desktop" FontSize="22" Margin="0,0,0,10"/>
            <TextBlock Text="Choose a background image to brighten up your workday." Margin="0,0,0,30" Foreground="#555"/>

            <Button Content="Browse for Wallpaper..." Click="BrowseWallpaper_Click" Width="200" HorizontalAlignment="Left" Padding="10,5"/>
            <TextBlock x:Name="SelectedFilePathText" Text="No file selected." Margin="0,10,0,0" Foreground="#888" FontStyle="Italic"/>

            <Button x:Name="ApplyWallpaperBtn" Content="Apply Now" Margin="0,30,0,0" Width="100" HorizontalAlignment="Left" IsEnabled="False" Click="ApplyWallpaper_Click"/>
        </StackPanel>
    </Grid>
</Page>
